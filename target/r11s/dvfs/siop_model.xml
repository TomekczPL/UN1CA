<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <EMR    formula="SKIN" temp="470" max_cpu="960000" max_gpu="303000" />
            <DEX    formula="SKIN" temp="470" />
            <LTB    formula="BAT*SKIN" temp="493.467" />
            <LCD    formula="BAT*SKIN" temp="472.451" />
            <GDMLTB formula="BAT*SKIN" temp="474.447" />
            <GDM    formula="BAT*SKIN" temp="450.429" />
            <SS     formula="SKIN*BAT" temp="510.490" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <Skin type="LRP2"/>
        <sensors>
            <LTB_SENSOR type="(PALM*LIGHT*FLICKER)+(POSITION*LIGHT*FLICKER)" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="SKIN" >
            <limiter name="OverLimit" temp="380:400:420" value="2400000:2208000:-1" />

            <limiter name="CPUFreqMax" multistage="1" 
                     temp="380:400:420:450" p="50" i="1" d="30" unit="1000"
                     load_gap="2:2:2:2"
                     min_high="2112000:1920000:1728000:1536000"
                     min="1920000:1728000:1536000:1344000" />

            <limiter name="GPUFreqMax" multistage="1"
                     temp="380:400:420:450" p="50" i="1" d="30" unit="600"
                     min="711000:605000:500000:303000" />
        </component>

        <component name="CP" tempType="SKIN">
            <limiter name="CpLowMode" temp="340:360:410:430" value="-1:2:2:1" />
            <limiter name="NrCCDrop"  temp="410:420" value="-1:1" />
            <limiter name="SADisable" temp="410:440" value="-1:1" />
            <limiter name="LteCCDrop" temp="430:450" value="-1:1" />
        </component>

        <component name="CP" tempType="SKIN" region="XSG">
            <limiter name="CpLowMode" temp="410:430" value="-1:1" />
            <limiter name="SADisable" temp="410:440" value="-1:1" />
        </component>

        <component name="CP" tempType="SKIN" region="KSA">
            <limiter name="CpLowMode" temp="410:430" value="-1:1" />
            <limiter name="SADisable" temp="410:440" value="-1:1" />
        </component>

        <component name="DISPLAY" tempType="SKIN">
            <limiter name="Brightness"     temp="380:400:420:450:470"    value="-1:215:172:126:101" />
        </component>

    </components>

    <scenarios>

        <scenario name="DefaultLowHeatMode" tempType="SKIN">
            <limiter name="OverLimit" temp="360:380:400" value="2400000:2208000:-1" />

            <limiter name="CPUFreqMax" multistage="1" 
                     temp="360:380:400:430" p="50" i="1" d="30" unit="1000"  stay="40"
                     load_gap="2:2:2:2"
                     min_high="2112000:1920000:1728000:1536000"
                     min="1920000:1728000:1536000:1344000"
                     max="2611000:2611000:2611000:2611000" />

            <limiter name="GPUFreqMax" multistage="1" 
                     temp="360:380:400:430" p="50" i="1" d="30" unit="600" stay="40"
                     min="711000:605000:500000:303000"
                     max="1210000:1210000:1210000:1210000" />

            <limiter name="BackgroundCpuset" temp="340" value="-1:100:200:300" />
        </scenario>

        <scenario name="SIPStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="380:400:420:440:470" value="-1:2611000:2400000:1920000:1344000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"         value="-1:500000" />
        </scenario>

        <scenario name="AppStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="380:400:420:440:470" value="-1:2611000:2400000:1920000:1344000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"         value="-1:500000" />
        </scenario>

        <scenario name="Badge" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="380:400:420:440:470" value="-1:2611000:2400000:1920000:1344000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"         value="-1:500000" />
        </scenario>

        <scenario name="CallStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="380:400:420:440:470" value="-1:2611000:2400000:1920000:1344000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"         value="-1:500000" />
        </scenario>

        <scenario name="WakeUp" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="380:400:420:440:470" value="-1:2611000:2400000:1920000:1344000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"         value="-1:500000" />
        </scenario>

        <scenario name="CameraControl" tempType="SKIN" priority="2" >
            <limiter name="CameraFps"  temp="360:380:400:420" value="-1:20:20:15" />
        </scenario>

        <scenario name="HighBrightness"  tempType="SKIN*BAT" priority="1" region="XSG" >
            <limiter name="CpLowMode"  temp="440.370:450.380:470.400" value="-1:1:1" delay="0:1800:0" />
            <limiter name="SADisable"  temp="440.370:450.380:470.400" value="-1:1:1" delay="0:1800:0" />
        </scenario>

        <scenario name="HighBrightness"  tempType="SKIN*BAT" priority="1" region="KSA" >
            <limiter name="CpLowMode"  temp="440.370:450.380:470.400" value="-1:1:1" delay="0:1800:0" />
            <limiter name="SADisable"  temp="440.370:450.380:470.400" value="-1:1:1" delay="0:1800:0" />
        </scenario>

        <scenario name="Navigation" tempType="SKIN" >
            <limiter name="Brightness" temp="420:450:470"    value="152:126:101" />
        </scenario>

    </scenarios>

</siop_document>